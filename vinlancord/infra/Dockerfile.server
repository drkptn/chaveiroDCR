# Imagem do servidor Vinlancord (API + gateway + SFU de voz + cliente web).
# Construir a partir da pasta vinlancord/:  docker build -f infra/Dockerfile.server -t vinlancord-server .
FROM node:22-trixie-slim AS build
WORKDIR /app
# python3-pip/make/g++: só usados se não houver binário pronto do mediasoup para a arquitetura (x64 e arm64 têm)
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip make g++ ca-certificates openssl && rm -rf /var/lib/apt/lists/*
ENV PIP_BREAK_SYSTEM_PACKAGES=1
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
RUN npm ci --workspace @vinlancord/server --workspace @vinlancord/web --workspace @vinlancord/shared --include-workspace-root=false --ignore-scripts=false
COPY packages/shared packages/shared
COPY apps/server apps/server
COPY apps/web apps/web
RUN cd apps/server && npx prisma generate && node build.mjs
RUN cd apps/web && npx vite build

FROM node:22-trixie-slim
ENV NODE_ENV=production
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl tini && rm -rf /var/lib/apt/lists/* && useradd -r -u 10001 vinlancord
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/server/package.json ./apps/server/package.json
COPY --from=build /app/apps/server/dist ./apps/server/dist
COPY --from=build /app/apps/server/prisma ./apps/server/prisma
COPY --from=build /app/apps/server/prisma.config.ts ./apps/server/prisma.config.ts
COPY --from=build /app/apps/web/dist ./apps/web/dist
RUN mkdir -p /data/uploads && chown -R vinlancord /data
USER vinlancord
WORKDIR /app/apps/server
ENV STORAGE_LOCAL_DIR=/data/uploads SERVE_WEB=/app/apps/web/dist PORT=8787 HOST=0.0.0.0
EXPOSE 8787
ENTRYPOINT ["/usr/bin/tini", "--"]
# aplica migrações pendentes e sobe o servidor
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/index.js"]
