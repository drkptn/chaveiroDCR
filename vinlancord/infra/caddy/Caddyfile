# HTTPS + proxy para a API, o gateway WebSocket e o cliente web.
# Domínio próprio: certificado Let's Encrypt automático. Só IP: certificado próprio (TLS_LINE).
{
	# conexões por IP não enviam SNI: usa o certificado do site
	default_sni {$DOMAIN}
}

{$DOMAIN} {
	{$TLS_LINE}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	request_body {
		max_size 60MB
	}
	reverse_proxy server:8787
}
