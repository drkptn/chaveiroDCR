{
  "name": "@vinlancord/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "prisma generate && node build.mjs",
    "typecheck": "prisma generate >/dev/null && tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vinlancord/shared": "*",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "file-type": "^22.3.0",
    "ioredis": "^6.0.0",
    "mediasoup": "^3.32.2",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
