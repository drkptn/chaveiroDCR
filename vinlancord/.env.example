# ───────────────────────── Vinlancord — produção (docker compose) ─────────────────────────
# Copie para vinlancord/.env e preencha. NUNCA versione o .env real.

# Domínio que aponta para o servidor (HTTPS automático via Caddy) e IP público da máquina
DOMAIN=vinlancord.seudominio.com
PUBLIC_IP=203.0.113.10

# Segredos (gere com: openssl rand -hex 32)
SECRET_KEY=
POSTGRES_PASSWORD=
TURN_SECRET=

# Cadastro: deixe REGISTRATION_CODE vazio para cadastro livre, ou defina um código para servidor só de amigos
REGISTRATION_ENABLED=true
REGISTRATION_CODE=
REQUIRE_EMAIL_VERIFICATION=false

# E-mail (verificação de conta e recuperação de senha). Sem SMTP, os links aparecem nos logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Vinlancord <no-reply@seudominio.com>

# Armazenamento de arquivos: local (volume Docker) ou s3 (AWS S3, Cloudflare R2, MinIO, Backblaze B2…)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Voz: quantos processos de mídia (1 por núcleo, até 4)
MEDIASOUP_WORKERS=2

# GIFs (opcional): chave gratuita em https://developers.giphy.com
GIPHY_API_KEY=

# Métricas Prometheus em /api/v1/metrics (opcional; sem token só responde localmente)
METRICS_TOKEN=
BACKUP_KEEP_DAYS=14
LOG_LEVEL=info
