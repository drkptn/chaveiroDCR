{
  "manifest_version": 3,
  "name": "Faxina de Republicados",
  "version": "1.1.0",
  "description": "Remove todos os seus republicados (reposts) do TikTok. Roda só na sua aba do tiktok.com: sem senha, sem servidor.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Faxina de Republicados",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "remover.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
